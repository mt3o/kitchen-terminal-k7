{
  "name": "kitchen-terminal-k7",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retro-futurist kitchen dashboard PWA for a wall-mounted iPad kiosk.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --experimental-strip-types src/server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node --experimental-strip-types src/server/index.ts",
    "serve": "npm run build && npm run start",
    "lint": "eslint .",
    "lint:tokens": "python3 scripts/check-token-contract.py",
    "check": "npm run lint && npm run lint:tokens && npm run build",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.12.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.14.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.2.2"
  }
}
