# Kitchen Terminal K7 — environment schema (Varlock)
#
# This file is the single source of truth for server-side configuration.
# It is committed to version control and safe for agents/humans to read —
# it declares shape and sensitivity only, never real values.
#
# Real secret values live in git-ignored .env.local (never read/edited by
# agents) or a secret provider. See docs/handoff/TECH-STACK.md and the
# CLAUDE.md standing constraint: "Secrets never reach the frontend."
#
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# API key for the Kilo Gateway AI service. Used server-side only to
# authenticate outbound calls to the gateway.
# @sensitive @required
KILO_GATEWAY_KEY=

# Long-lived Google Calendar OAuth2 refresh token, used to mint access
# tokens for the calendar integration without re-running the consent flow.
# @sensitive @required
GOOGLE_OAUTH_REFRESH_TOKEN=

# OAuth2 client id/secret for the Google Calendar app registration the refresh
# token above was issued against. All three (this pair plus the refresh token)
# are obtained manually by the household and pasted in here — there is no
# consent-flow UI. Absent is a supported way to run: a Google-sourced calendar
# with no credentials configured falls back to the existing mock events rather
# than erroring.
# @sensitive @optional
GOOGLE_OAUTH_CLIENT_ID=
# @sensitive @optional
GOOGLE_OAUTH_CLIENT_SECRET=

# Unsplash API access key ("Client-ID"), for the unsplash-carousel card. Sent
# only from the server; the browser gets photo URLs and attribution, never the
# key. Absent means that card shows its fail state — the server still starts.
# K7_-prefixed like the rest of this project's own settings: that is what the
# deployed .env.local already used, and the code was the side that was wrong.
# @sensitive @optional
K7_UNSPLASH_ACCESS_KEY=

# Unsplash API secret key. Only needed for OAuth user flows, which K7 does not
# use; declared so its value is known to be sensitive and scrubbed from reports.
# @sensitive @optional
K7_UNSPLASH_SECRET_KEY=

# The application name registered with Unsplash, used as utm_source on the
# photographer/Unsplash attribution links their API guidelines require.
# @public @optional
K7_UNSPLASH_APP_NAME=kitchen_terminal_k7

# GlitchTip error-tracking DSN. When absent, error reporting is simply
# disabled — the server must not fail to start without it.
# @sensitive @optional @type=url
GLITCHTIP_DSN=

# TCP port the K7 backend HTTP server listens on.
# @public @type=port
K7_PORT=8080

# Host/interface the K7 backend binds to (0.0.0.0 = all interfaces).
# @public
K7_HOST=0.0.0.0

# Loopback address of a reverse proxy in front of this process (e.g. nginx on
# the same machine), or unset when nothing sits in front. Only a request whose
# TCP peer is this address gets its X-Forwarded-For honoured for req.ip and
# for the LAN-source check — set this to the proxy's address, never to
# anything reachable from outside this machine.
# @public @optional
K7_TRUST_PROXY=

# Cloudflare API token, scoped to Zone:DNS:Edit on the zone that holds the
# kiosk's hostname. Used only to write and delete the _acme-challenge TXT
# record during certificate issuance. Absent means TLS is disabled and the
# server falls back to plain HTTP — which also means no Service Worker.
# @sensitive @optional
CLOUDFLARE_API_TOKEN=

# Fully-qualified name the kiosk is reached at. Two jobs, and the second is the
# one that bites: it is the name a certificate is issued for, AND the name the
# Host-header allowlist accepts. Leave it unset and the kiosk answers on its IP
# but returns 400 for its own hostname — which looks like DNS being broken.
# Must be inside a zone the Cloudflare token can edit.
# @public
K7_HOSTNAME=

# Contact address for the ACME account. Let's Encrypt uses it for expiry
# warnings, which is the safety net if in-process renewal ever stops working.
# @sensitive @optional
K7_ACME_EMAIL=

# Issue against Let's Encrypt production rather than staging. Staging is the
# default on purpose: production allows five duplicate certificates per week
# and a retry loop during setup burns the budget with no cure but waiting.
# A staging certificate is real but NOT browser-trusted — expect a warning.
# @public @type=boolean
K7_ACME_PRODUCTION=false

# Directory holding the recipe collection: one Markdown file per recipe,
# named by its id, safe to edit by hand while the server runs. Kept outside
# the deployed checkout on purpose — deploy.sh does `git reset --hard` there,
# and the recipes are household data to back up and sync on their own
# schedule, not build output. Unset means
# $XDG_DATA_HOME/kitchen-terminal-k7/przepisy, else
# ~/.local/share/kitchen-terminal-k7/przepisy (./data/przepisy only when the
# process has no HOME). On first start, recipes still in SQLite are copied here
# once; a .migrated-from-sqlite marker in this directory records that it ran.
# @public @optional
K7_RECIPES_DIR=

# Guards the admin routes, including the browser flow that connects the
# household's Google account (`/admin`). Unset means those routes answer 404 —
# a deployment that has not opted in exposes no credential-granting surface at
# all. The same value is pasted into the admin page's localStorage on whichever
# laptop does the connecting; the server side is the half that enforces it.
# Generate with: openssl rand -base64 32
# @sensitive @optional
K7_ADMIN_TOKEN=

# 32 bytes, base64. Encrypts credentials stored in the database (AES-256-GCM,
# see src/server/crypto/secret-box.ts) — today just the Google refresh token a
# browser consent produced. Unset means the browser flow is off rather than
# storing a token in the clear. This protects a database file that leaks on its
# own (a backup, a copy handed over for debugging); it does not protect against
# shell access on the host, where this key is readable from this very file.
# Generate with: openssl rand -base64 32
# @sensitive @optional
K7_SECRET_KEY=
