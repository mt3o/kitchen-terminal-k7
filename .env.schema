# Kitchen Terminal K7 — environment schema (Varlock)
#
# This file is the single source of truth for server-side configuration.
# It is committed to version control and safe for agents/humans to read —
# it declares shape and sensitivity only, never real values.
#
# Real secret values live in git-ignored .env.local (never read/edited by
# agents) or a secret provider. See docs/handoff/TECH-STACK.md and the
# CLAUDE.md standing constraint: "Secrets never reach the frontend."
#
# @defaultSensitive=false
# @defaultRequired=infer
# ---

# API key for the Kilo Gateway AI service. Used server-side only to
# authenticate outbound calls to the gateway.
# @sensitive @required
KILO_GATEWAY_KEY=

# Long-lived Google Calendar OAuth2 refresh token, used to mint access
# tokens for the calendar integration without re-running the consent flow.
# @sensitive @required
GOOGLE_OAUTH_REFRESH_TOKEN=

# GlitchTip error-tracking DSN. When absent, error reporting is simply
# disabled — the server must not fail to start without it.
# @sensitive @optional @type=url
GLITCHTIP_DSN=

# TCP port the K7 backend HTTP server listens on.
# @public @type=port
K7_PORT=8080

# Host/interface the K7 backend binds to (0.0.0.0 = all interfaces).
# @public
K7_HOST=0.0.0.0

# Cloudflare API token, scoped to Zone:DNS:Edit on the zone that holds the
# kiosk's hostname. Used only to write and delete the _acme-challenge TXT
# record during certificate issuance. Absent means TLS is disabled and the
# server falls back to plain HTTP — which also means no Service Worker.
# @sensitive @optional
CLOUDFLARE_API_TOKEN=

# Fully-qualified name the kiosk is reached at. Must be inside a zone the
# token above can edit.
# @public
K7_TLS_HOSTNAME=

# Contact address for the ACME account. Let's Encrypt uses it for expiry
# warnings, which is the safety net if in-process renewal ever stops working.
# @sensitive @optional
K7_ACME_EMAIL=

# Issue against Let's Encrypt production rather than staging. Staging is the
# default on purpose: production allows five duplicate certificates per week
# and a retry loop during setup burns the budget with no cure but waiting.
# A staging certificate is real but NOT browser-trusted — expect a warning.
# @public @type=boolean
K7_ACME_PRODUCTION=false
