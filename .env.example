# Kitchen Terminal K7 — example env file
#
# Copy relevant values into your git-ignored .env.local (or set them via
# your secret provider). Every value below is an obviously-fake placeholder —
# do not use these as real credentials. See .env.schema for the authoritative
# schema (types, required/sensitive flags, descriptions).

# API key for the Kilo Gateway AI service.
KILO_GATEWAY_KEY=sk-REPLACE_ME_WITH_REAL_KILO_GATEWAY_KEY

# Long-lived Google Calendar OAuth2 refresh token.
GOOGLE_OAUTH_REFRESH_TOKEN=1//REPLACE_ME_WITH_REAL_GOOGLE_REFRESH_TOKEN

# Unsplash API access key and secret (unsplash-carousel card). Only the access
# key is used; leave both unset and that card shows its fail state.
K7_UNSPLASH_ACCESS_KEY=REPLACE_ME_WITH_REAL_UNSPLASH_ACCESS_KEY
K7_UNSPLASH_SECRET_KEY=REPLACE_ME_WITH_REAL_UNSPLASH_SECRET_KEY

# GlitchTip error-tracking DSN. Leave unset to disable error reporting.
GLITCHTIP_DSN=https://examplePublicKey@app.glitchtip.example/00000

# TCP port the K7 backend HTTP server listens on.
K7_PORT=8080

# Host/interface the K7 backend binds to.
K7_HOST=0.0.0.0

# See .env.schema. Both optional: together they enable connecting Google from a
# browser at /admin, instead of pasting GOOGLE_OAUTH_REFRESH_TOKEN by hand.
K7_ADMIN_TOKEN=
K7_SECRET_KEY=
